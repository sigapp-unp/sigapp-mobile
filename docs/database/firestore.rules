rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(studentCode) {
      return request.auth != null && request.auth.uid == studentCode;
    }

    // (opcional) admins via custom claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Doc raíz del alumno
    match /students/{studentCode} {
      allow read, write: if isOwner(studentCode) || isAdmin();

      // Todo lo que cuelga del alumno (gradeSimulations, preferences, etc.)
      match /{document=**} {
        allow read, write: if isOwner(studentCode) || isAdmin();
      }
    }

    // Niega todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
